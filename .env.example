# Public URL of the site, used for Mollie redirects and webhooks.
# Local: http://localhost:3000 — production: https://<your-domain>
BASE_URL=http://localhost:3000

# Domain shown in texts and emails (“<domain>/support”), without https://. Set it with the domain name.
NEXT_PUBLIC_SITE_DOMAIN=

# Neon Postgres connection string. Leave empty locally to use the
# embedded PGlite database stored in .data/ (no install needed).
DATABASE_URL=

# Mollie API key. test_... for test mode, live_... in production.
# Leave empty locally to use the built-in mock payment page (dev only).
MOLLIE_API_KEY=

# Prices in cents.
PRICE_EUR_CENTS=3000
PRICE_USD_CENTS=4500
CORPORATE_RATE_CENTS=43000

# Minutes a place stays held while the student pays.
HOLD_MINUTES=15

# Support email shown on the site.
SUPPORT_EMAIL=support@example.com

# Legal entity operating The AI Certification (shown in the footer and legal notice).
COMPANY_NAME=Pierre Cazaban EI
COMPANY_LEGAL_FORM=Entrepreneur individuel (micro-entreprise)
COMPANY_SIREN=132 067 414
COMPANY_ADDRESS=74 rue du Mas de Caze, 34090 Montpellier, France
COMPANY_PUBLISHER=Pierre Cazaban
# true = franchise en base de TVA (no VAT charged, art. 293 B CGI)
VAT_EXEMPT=true
COMPANY_VAT_NUMBER=
HOSTING_PROVIDER=Vercel Inc., 440 N Barranca Ave #4133, Covina, CA 91723, United States

# Comma-separated emails allowed into the admin console.
ADMIN_EMAILS=
# Password for the admins until they set their own (sign in at /login). Value from: node scripts/hash-password.mjs '<password>'
ADMIN_PASSWORD_HASH=
# Resend (emails). Without a key, emails are only stored and visible in the admin console.
RESEND_API_KEY=
EMAIL_FROM=The AI Certification <noreply@your-domain.com>
# Lessons open on the cohort start date; true opens them right after payment.
COURSE_OPEN_EARLY=false
